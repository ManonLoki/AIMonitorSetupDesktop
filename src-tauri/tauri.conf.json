{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AIMonitor",
  "mainBinaryName": "AIMonitor",
  "version": "1.0.1",
  "identifier": "com.manonloki.ai-monitor-setup",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AI Monitor",
        "width": 1100,
        "height": 720,
        "minWidth": 760,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/ai-monitor/32x32.png",
      "icons/ai-monitor/128x128.png",
      "icons/ai-monitor/128x128@2x.png",
      "icons/ai-monitor/icon.icns",
      "icons/ai-monitor/icon.ico"
    ]
  }
}
