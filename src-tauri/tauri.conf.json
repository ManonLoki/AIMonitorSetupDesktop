{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AIMonitor",
  "mainBinaryName": "AIMonitor",
  "version": "2.2.7",
  "identifier": "com.manonloki.ai-monitor-setup",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AI Monitor",
        "width": 1100,
        "height": 720,
        "minWidth": 760,
        "minHeight": 560,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "category": "Utility",
    "publisher": "AIMonitor",
    "copyright": "Copyright © 2026 AIMonitor. All rights reserved.",
    "shortDescription": "配置并管理 AIMonitor 设备与 AI 工具联动。",
    "longDescription": "发现局域网中的 AIMonitor 设备，管理设备状态、图片资源以及 AI 工具的 Hook 配置。",
    "icon": [
      "icons/ai-monitor/32x32.png",
      "icons/ai-monitor/128x128.png",
      "icons/ai-monitor/128x128@2x.png",
      "icons/ai-monitor/icon.icns",
      "icons/ai-monitor/icon.ico"
    ]
  }
}
